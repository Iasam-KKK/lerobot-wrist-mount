<?xml version="1.0"?>
<!-- Minimal bench for the SO-101 wrist camera: a work surface and three
     graspable objects placed inside the camera cone so the feed shows
     something recognisable immediately. -->
<sdf version="1.10">
  <world name="pick_bench">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Without this the camera sensor produces no images. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.78 1</ambient>
            <diffuse>0.75 0.75 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Graspable objects, sized for the SO-101's ~35 mm jaw opening.

         Positions are NOT arbitrary. Each sits where the wrist camera's optical
         axis actually meets the table for one shot of the demo sweep, measured
         from live tf by scripts/aim_points.py:
           cube_red        mean of look-down / descend / wrist-roll aim points
           cube_blue       the sweep-left aim point
           cylinder_yellow the sweep-right aim point
         Move the arm plan and these need re-measuring, or the shots miss. -->
    <model name="cube_red">
      <pose>0.245 -0.010 0.0125 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>5.2e-6</ixx><iyy>5.2e-6</iyy><izz>5.2e-6</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material>
            <ambient>0.7 0.12 0.12 1</ambient>
            <diffuse>0.8 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cube_blue">
      <pose>0.247 -0.073 0.0125 0 0 0.4</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>5.2e-6</ixx><iyy>5.2e-6</iyy><izz>5.2e-6</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material>
            <ambient>0.12 0.2 0.65 1</ambient>
            <diffuse>0.15 0.25 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cylinder_yellow">
      <pose>0.254 0.103 0.02 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia><ixx>8.0e-6</ixx><iyy>8.0e-6</iyy><izz>4.5e-6</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.015</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.015</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.62 0.1 1</ambient>
            <diffuse>0.9 0.75 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
